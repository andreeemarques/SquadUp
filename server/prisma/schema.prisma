generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(uuid())
  username  String      @unique
  email     String      @unique
  password  String
  avatar    String?
  createdAt DateTime    @default(now())
  posts     SquadPost[]
}

model SquadPost {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  platform      Platform
  region        Region
  rank          Rank
  mode          GameMode
  language      Language
  micRequired   Boolean
  playersNeeded Int
  description   String
  createdAt     DateTime @default(now())
}

enum Platform {
  PC
  PlayStation
  Xbox
}

enum Region {
  North_America
  Europe
  South_America
  Asia
  Oceania
}

enum Rank {
  Copper
  Bronze
  Silver
  Gold
  Platinum
  Emerald
  Diamond
  Champion
}

enum GameMode {
  Ranked
  Standard
  Quick_Match
}

enum Language {
  English
  Spanish
  French
  German
  Portuguese
}