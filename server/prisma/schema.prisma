generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String         @id @default(uuid())
  username             String         @unique
  email                String         @unique
  password             String
  avatar               String?
  ubisoftId            String?
  platform             Platform?
  bio                  String?
  preferredOperators   String[]       @default([])
  createdAt            DateTime       @default(now())
  posts                SquadPost[]
  receivedNotifications Notification[] @relation("ReceivedNotifications")
  sentNotifications     Notification[] @relation("SentNotifications")
}

model SquadPost {
  id            String         @id @default(uuid())
  user          User           @relation(fields: [userId], references: [id])
  userId        String
  platform      Platform
  region        Region
  rank          Rank
  mode          GameMode
  language      Language
  micRequired   Boolean
  playersNeeded Int
  description   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
}

model Notification {
  id          String             @id @default(uuid())
  recipient   User               @relation("ReceivedNotifications", fields: [recipientId], references: [id])
  recipientId String
  actor       User               @relation("SentNotifications", fields: [actorId], references: [id])
  actorId     String
  squadPost   SquadPost?         @relation(fields: [squadPostId], references: [id])
  squadPostId String?
  type        NotificationType
  status      NotificationStatus @default(PENDING)
  read        Boolean            @default(false)
  createdAt   DateTime           @default(now())
}

enum NotificationType {
  JOIN_REQUEST
  JOIN_ACCEPTED
  JOIN_DECLINED
}

enum NotificationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum Platform {
  PC
  PlayStation
  Xbox
}

enum Region {
  North_America
  Europe
  South_America
  Asia
  Oceania
}

enum Rank {
  Copper
  Bronze
  Silver
  Gold
  Platinum
  Emerald
  Diamond
  Champion
}

enum GameMode {
  Ranked
  Standard
  Quick_Match
}

enum Language {
  English
  Spanish
  French
  German
  Portuguese
}